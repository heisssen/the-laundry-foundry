<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="bio">
  <div class="bio-grid">
    <div class="form-group"><label>{{localize "LAUNDRY.Details.codename"}}</label><input type="text" name="system.details.codename" value="{{system.details.codename}}"></div>
    <div class="form-group"><label>{{localize "LAUNDRY.Details.nickname"}}</label><input type="text" name="system.details.nickname" value="{{system.details.nickname}}"></div>
    <div class="form-group"><label>{{localize "LAUNDRY.Details.assignment"}}</label><input type="text" name="system.details.assignment" value="{{system.details.assignment}}"></div>
    <div class="form-group"><label>{{localize "LAUNDRY.Details.department"}}</label><select name="system.details.department">{{selectOptions config.departments selected=system.details.department localize=true blank="—"}}</select></div>
    <div class="form-group"><label>{{localize "LAUNDRY.Details.age"}}</label><input type="text" name="system.details.age" value="{{system.details.age}}"></div>
    <div class="form-group"><label>{{localize "LAUNDRY.Details.eyes"}}</label><input type="text" name="system.details.eyes" value="{{system.details.eyes}}"></div>
    <div class="form-group"><label>{{localize "LAUNDRY.Details.hair"}}</label><input type="text" name="system.details.hair" value="{{system.details.hair}}"></div>
    <div class="form-group"><label>{{localize "LAUNDRY.Details.features"}}</label><input type="text" name="system.details.features" value="{{system.details.features}}"></div>
  </div>

  <h3 class="section-title">{{localize "LAUNDRY.Details.goals"}}</h3>
  <div class="goals">
    <div class="goal-row">
      <label>{{localize "LAUNDRY.Details.shortGoal"}} <small>+1 XP</small></label>
      <input type="text" name="system.details.goals.short" value="{{system.details.goals.short}}" placeholder="{{localize 'LAUNDRY.Goals.ShortPlaceholder'}}">
      {{#if editable}}<button type="button" data-action="achieveGoal" data-kind="short" {{#unless system.details.goals.short}}disabled{{/unless}} data-tooltip="{{localize 'LAUNDRY.Goals.AchieveHint'}}"><i class="fa-solid fa-check"></i> {{localize "LAUNDRY.Goals.Achieved"}}</button>{{/if}}
    </div>
    <div class="goal-row">
      <label>{{localize "LAUNDRY.Details.longGoal"}} <small>+10 XP</small></label>
      <input type="text" name="system.details.goals.long" value="{{system.details.goals.long}}" placeholder="{{localize 'LAUNDRY.Goals.LongPlaceholder'}}">
      {{#if editable}}<button type="button" data-action="achieveGoal" data-kind="long" {{#unless system.details.goals.long}}disabled{{/unless}} data-tooltip="{{localize 'LAUNDRY.Goals.AchieveHint'}}"><i class="fa-solid fa-check"></i> {{localize "LAUNDRY.Goals.Achieved"}}</button>{{/if}}
    </div>
    {{#if system.details.goals.achieved.length}}
    <ol class="goals-achieved">
      <li class="head">{{localize "LAUNDRY.Goals.History"}}</li>
      {{#each system.details.goals.achieved}}<li><s>{{text}}</s> <span class="tag">{{#if (laundry-eq kind "long")}}{{localize "LAUNDRY.Details.longGoal"}}{{else}}{{localize "LAUNDRY.Details.shortGoal"}}{{/if}}</span> <span class="xp">+{{xp}} XP</span> <span class="date">{{date}}</span></li>{{/each}}
    </ol>
    {{/if}}
  </div>

  <div class="form-group stacked">
    <label>{{localize "LAUNDRY.Details.connections"}}</label>
    <textarea name="system.details.connections" rows="3">{{system.details.connections}}</textarea>
  </div>

  <h3 class="section-title">{{localize "LAUNDRY.Details.biography"}}</h3>
  <prose-mirror name="system.details.biography" value="{{system.details.biography}}" toggled="true">{{{enriched.biography}}}</prose-mirror>

  <h3 class="section-title">{{localize "LAUNDRY.Details.notes"}}</h3>
  <prose-mirror name="system.details.notes" value="{{system.details.notes}}" toggled="true">{{{enriched.notes}}}</prose-mirror>
</section>
