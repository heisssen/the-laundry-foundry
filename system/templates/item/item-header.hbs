<header class="sheet-header item-header">
  <img class="profile" src="{{item.img}}" data-edit="img" data-action="editImage">
  <div class="header-main">
    <input class="item-name" type="text" name="name" value="{{item.name}}">
    <div class="item-type">{{localize (concat "TYPES.Item." item.type)}}
      {{#if item.actor}}<a data-action="use" class="use-btn"><i class="fa-solid fa-play"></i> {{localize "LAUNDRY.Sheet.Use"}}</a>{{/if}}
    </div>
    <div class="form-row small">
      <label>{{localize "LAUNDRY.Item.identifier"}} <input type="text" name="system.identifier" value="{{system.identifier}}" placeholder="camelCaseId"></label>
      <label>{{localize "LAUNDRY.Item.source"}} <input type="text" name="system.source" value="{{system.source}}" placeholder="OH p.66"></label>
    </div>
  </div>
</header>
