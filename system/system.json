{
  "id": "the-laundry",
  "title": "The Laundry RPG",
  "description": "Unofficial fan-made system for The Laundry Roleplaying Game (Cubicle 7). Mechanics, sheets and automation only — bring your own content from the books.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "The Laundry fan system"
    }
  ],
  "esmodules": [
    "laundry.mjs"
  ],
  "styles": [
    "styles/laundry.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "details.biography",
          "details.notes"
        ]
      },
      "npc": {
        "htmlFields": [
          "description",
          "notes"
        ]
      },
      "team": {
        "htmlFields": [
          "notes",
          "allies",
          "rumours"
        ]
      },
      "vehicle": {
        "htmlFields": [
          "description"
        ]
      }
    },
    "Item": {
      "talent": {
        "htmlFields": [
          "description"
        ]
      },
      "weapon": {
        "htmlFields": [
          "description"
        ]
      },
      "armour": {
        "htmlFields": [
          "description"
        ]
      },
      "gear": {
        "htmlFields": [
          "description"
        ]
      },
      "spell": {
        "htmlFields": [
          "description",
          "effect"
        ]
      },
      "app": {
        "htmlFields": [
          "description"
        ]
      },
      "assignment": {
        "htmlFields": [
          "description"
        ]
      },
      "injury": {
        "htmlFields": [
          "description"
        ]
      }
    },
    "RegionBehavior": {
      "zone": {}
    }
  },
  "packs": [
    {
      "name": "vehicles",
      "label": "Vehicles",
      "path": "packs/vehicles",
      "type": "Actor",
      "system": "the-laundry",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {}
    },
    {
      "name": "macros",
      "label": "Laundry Macros",
      "path": "packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "The Laundry",
      "sorting": "m",
      "color": "#2b3a2f",
      "packs": [
        "macros",
        "vehicles"
      ]
    }
  ],
  "grid": {
    "distance": 5,
    "units": "m"
  },
  "initiative": "@initiative",
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
  "socket": true,
  "primaryTokenAttribute": "toughness",
  "secondaryTokenAttribute": "adrenaline",
  "url": "https://github.com/heisssen/the-laundry-foundry",
  "manifest": "https://github.com/heisssen/the-laundry-foundry/releases/latest/download/system.json",
  "download": "https://github.com/heisssen/the-laundry-foundry/releases/download/v1.0.0/the-laundry-1.0.0.zip",
  "bugs": "https://github.com/heisssen/the-laundry-foundry/issues",
  "changelog": "https://github.com/heisssen/the-laundry-foundry/blob/main/CHANGELOG.md",
  "readme": "https://github.com/heisssen/the-laundry-foundry/blob/main/README.md"
}
